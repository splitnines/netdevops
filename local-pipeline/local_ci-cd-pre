#!/usr/bin/env bash

set -eu

RED='\033[0;31m'
GREEN='\033[0;33m'
YELLOW='\033[0;31m'
RESET='\033[0m'

logger() {
    local prefix=${1:-cicd}
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    printf '%s [%s-commit]:' "$ts" "$prefix"
}

repo_root=${1:?Missing repository root}
branch=${2:?Missing branch name}
commit=${3:?Missing commit SHA}

playbook_dir="$repo_root/playbooks"

log_dir="$repo_root/logs" && mkdir -p "$log_dir"

ts=$(date '+%Y%m%d-%H%M%S')
ansible_log_file="$log_dir/ansible-pre-cicd-$ts-$$.log"

cd "$repo_root"

playbooks=false
for file in "$playbook_dir"/*.yml "$playbook_dir"/*.yaml; do
    if [[ -f "$file" ]]; then
        playbooks=true
        break
    fi
done

if [[ "$playbooks" = true ]]; then
    echo ""
    echo "========================================"
    echo "$(logger "pre") Local CI/CD started"
    echo "$(logger "pre") Repository: $repo_root"
    echo "$(logger "pre") Branch:     $branch"
    echo "$(logger "pre") Commit:     $commit"
    echo "========================================"

    # sync python environment
    echo ""
    echo "$(logger "pre") Sync'ing python environment..."
    echo ""
    uv python install 3.14
    uv sync --python 3.14
    echo ""
    # echo "$(logger "pre") Python environment sync complete."
    printf "%s ${GREEN}Python environment sync complete" "$(logger "pre")"
    echo "========================================"
    echo ""
fi

# Ansible syntax check
if [[ "$playbooks" = true ]]; then
    echo "$(logger "pre") Running Ansible Syntax Check..."
    echo ""

    if ! find playbooks -maxdepth 1 -type f \
        \( -name '*.yml' -o -name '*.yaml' \) \
        -exec uv run ansible-playbook \
        --syntax-check \
        -i inventory/inventory.yml {} + >>"$ansible_log_file" 2>&1; then
        echo "$(logger "pre") Ansible syntax check failed, exiting pipeline"
        echo "========================================"
        echo ""
        exit 1
    fi
    echo ""
    # echo "$(logger "pre") Ansible syntax check successful"
    printf "%s ${GREEN}Ansible syntax check successful" "$(logger "pre")"
    echo "========================================"
    echo ""
fi

# Ansible backups
backup=false
backup_file=""
for file in "$playbook_dir/"config_backup*.yml "$playbook_dir/"config_backup*.yaml; do
    if [[ -f "$file" ]]; then
        backup=true
        backup_file=${file##*/}
        break
    fi
done

if [[ "$backup" = true ]]; then
    echo "$(logger "pre") Runnning Ansible Backups..."
    echo ""
    if ! uv run ansible-playbook \
        -i inventory/inventory.yml \
        "$playbook_dir"/"$backup_file" >>"$ansible_log_file" 2>&1; then
        echo "$(logger "pre") Ansible backup failed, exiting pipeline"
        echo "========================================"
        echo ""
        exit 1
    fi
    echo "$(logger "pre") Ansible backups completed successfully."
    echo "$(logger "pre") Backups saved to $repo_root/backups"
    echo "========================================"
    echo ""
fi

if [[ "$playbooks" = true || "$backup" = true ]]; then
    echo "$(logger "pre") Local CI/CD completed successfully for $branch at $commit."
    echo "========================================"
    echo ""
fi
