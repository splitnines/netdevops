#!/bin/sh
set -eu

repo_root=${1:?Missing repository root}
branch=${2:?Missing branch name}
commit=${3:?Missing commit SHA}

playbook_dir="$repo_root/playbooks"
tests_dir="$repo_root/tests"

cd "$repo_root"

echo ""
echo "========================================"
echo "Local CI/CD started"
echo "Repository: $repo_root"
echo "Branch:     $branch"
echo "Commit:     $commit"
echo "========================================"

echo ""
echo "Sync'ing python environment..."
echo ""
uv python install 3.14
uv sync --python 3.14
echo ""
echo "Python environment sync complete."
echo "========================================"
echo""

playbooks=false
for file in "$playbook_dir"/*.yml "$playbook_dir"/*.yml; do
    if [ -f "$file" ]; then
        playbooks=true
        break
    fi
done

if [ "$playbooks" = true ]; then
    echo "Running Ansible Syntax Check..."
    echo "========================================"

    if ! find playbooks -maxdepth 1 -type f \
        \( -name '*.yml' -o -name '*.yaml' \) \
        -exec uv run ansible-playbook \
        --syntax-check \
        -i inventory/inventory.yml {} +; then
        echo "Ansible syntax check failed, exiting pipeline"
        echo "========================================"
        echo ""
        exit 1
    fi
    echo ""
    echo "Ansible syntax check successful"
    echo "========================================"
    echo ""
fi

backup=false
backup_file=""
for file in "$playbook_dir/"config_backup*.yml "$playbook_dir/"config_backup*.yaml; do
    if [ -f "$file" ]; then
        backup=true
        backup_file=${file##*/}
        break
    fi
done

if [ "$backup" = true ]; then
    echo "Runnning Ansible Backups..."
    echo "========================================"
    if ! uv run ansible-playbook \
        -i inventory/inventory.yml \
        "$playbook_dir"/"$backup_file"; then
        echo "Ansible backup failed, exiting pipeline"
        echo "========================================"
        echo ""
        exit 1
    fi
    echo "Ansible backups completed successfully."
    echo "Backups saved to $repo_root/backups"
    echo "========================================"
    echo ""
fi

if [ "$playbooks" = true ]; then
    echo "Running Ansible playbooks..."
    echo "========================================"
    for playbook in playbooks/*.yml playbooks/*.yaml; do
        [ -f "$playbook" ] || continue

        case ${playbook##*/} in
        *config_backup.yml | *config_backup.yaml)
            continue
            ;;
        esac

        echo "Running: $playbook"

        if ! uv run ansible-playbook \
            -i inventory/inventory.yml \
            "$playbook"; then
            echo "Playbook failed: $playbook"
            echo "========================================"
            echo ""
            exit 1
        fi
    done
    echo "Ansible playbooks completed successfully."
    echo "========================================"
    echo ""
fi

pyats_status=0
if [ -f "$tests_dir"/job.py ]; then
    echo "Running pyATS tests..."
    echo "========================================"

    if uv run pyats run job tests/job.py --no-mail --no-archive; then
        echo "pyATS tests complete."
        echo "========================================"
        echo ""
    else
        pyats_status=$?
        echo "pyATS tests failed with status $pyats_status"
        echo "========================================"
        echo ""
    fi
fi
#testing

echo "Local CI/CD completed successfully for $branch at $commit."
echo "========================================"
echo ""
