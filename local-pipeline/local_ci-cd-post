#!/usr/bin/env bash

set -eu

RED='\033[0;31m'
GREEN='\033[0;32m'
# YELLOW='\033[0;33m'
RESET='\033[0m'

logger() {
    local postfix=${1:-cicd}
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    printf '%s [%s-commit]:' "$ts" "$postfix"
}

repo_root=${1:?Missing repository root}
branch=${2:?Missing branch name}
commit=${3:?Missing commit SHA}

playbook_dir="$repo_root/playbooks"
tests_dir="$repo_root/tests"

log_dir="$repo_root/logs" && mkdir -p "$log_dir"

ansible_log_file="$log_dir/ansible-post-cicd-$commit.log"
pyats_log_file="$log_dir/pyats-post-cicd-$commit.log"
git_log_file="$log_dir/git-log.log"

exec > >(tee -a "$git_log_file") 2>&1

cd "$repo_root"

playbooks=false
for file in "$playbook_dir"/*.yml "$playbook_dir"/*.yml; do
    if [[ -f "$file" ]]; then
        playbooks=true
        break
    fi
done

if [[ "$playbooks" = true ]]; then
    echo "$(logger "post") Local CI/CD started"
    echo "$(logger "post") Repository: $repo_root"
    echo "$(logger "post") Branch: $branch"
    echo "$(logger "post") Commit: $commit"
fi

# Ansible playbooks
if [[ "$playbooks" = true ]]; then
    echo "$(logger "post") Running Ansible playbooks..."
    for playbook in playbooks/*.yml playbooks/*.yaml; do
        [[ -f "$playbook" ]] || continue

        case ${playbook##*/} in
        *config_backup*.yml | *config_backup*.yaml)
            continue
            ;;
        esac

        echo "$(logger "post") Running: $playbook"

        if ! uv run ansible-playbook \
            -i inventory/inventory.yml \
            "$playbook" >>"$ansible_log_file" 2>&1; then
            printf "${RED}%s Ansible playbook failed: %s${RESET}\n" \
                "$(logger "post")" "$playbook"
            exit 1
        fi
    done
    printf "${GREEN}%s Ansible playbooks completed successfully${RESET}\n" \
        "$(logger "post")"
fi

# pyATS tests
pyats_status=0
if [[ -f "$tests_dir"/job.py ]]; then
    echo "$(logger "post") Running pyATS tests..."
    echo ""

    if uv run pyats run job tests/job.py --no-mail --no-archive >>"$pyats_log_file" 2>&1; then
        printf "${GREEN}%s pyATS tests completed successfully${RESET}\n" \
            "$(logger "post")"
    else
        pyats_status=$?
        printf "${RED}%s pyATS tests failed with status %s${RESET}\n" \
            "$(logger "post")" "$pyats_status"
    fi
fi

if [[ "$playbooks" = true || -f "$tests_dir"/job.py ]]; then
    printf "${GREEN}%s Local post-commit CI/CD completed successfully for %s at %s${RESET}\n" \
        "$(logger "post")" "$branch" "$commit"
fi
