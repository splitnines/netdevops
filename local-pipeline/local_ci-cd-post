# Ansible playbooks
if [[ "$playbooks" = true ]]; then
    echo "[post-commit] Running Ansible playbooks..."
    echo ""
    for playbook in playbooks/*.yml playbooks/*.yaml; do
        [[ -f "$playbook" ]] || continue

        case ${playbook##*/} in
        *config_backup*.yml | *config_backup*.yaml)
            continue
            ;;
        esac

        echo "[post-commit] Running: $playbook"

        if ! uv run ansible-playbook \
            -i inventory/inventory.yml \
            "$playbook" >>"$ansible_log_file" 2>&1; then
            echo "[post-commit] Playbook failed: $playbook"
            echo "========================================"
            echo ""
            exit 1
        fi
    done
    echo ""
    echo "[post-commit] Ansible playbooks completed successfully."
    echo "========================================"
    echo ""
fi

# pyATS tests
pyats_status=0
if [[ -f "$tests_dir"/job.py ]]; then
    echo "[post-commit] Running pyATS tests..."
    echo ""

    if uv run pyats run job tests/job.py --no-mail --no-archive >>"$pyats_log_file" 2>&1; then
        echo "[post-commit] pyATS tests completeed successfully."
        echo "========================================"
        echo ""
    else
        pyats_status=$?
        echo "[post-commit] pyATS tests failed with status $pyats_status"
        echo "========================================"
        echo ""
    fi
fi

echo "[post-commit] Local CI/CD completed successfully for $branch at $commit."
