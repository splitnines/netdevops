#!/usr/bin/env bash

set -u

logger() {
    local prefix=${1:-cicd}
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    printf '%s [%s-commit]:' "$ts" "$prefix"
}

repo_root=$(git rev-parse --show-toplevel) || exit 1
branch=$(git branch --show-current)
playbook_dir="$repo_root/playbooks"

if [[ -z "$branch" ]]; then
    echo "$(logger "pre") Detached HEAD; skipping CI/CD."
    exit 0
fi

if [[ "$branch" = "main" ]]; then
    echo "$(logger "pre") Commit is on main; skipping CI/CD."
    exit 0
fi

commit=$(git rev-parse HEAD)

pipeline="$repo_root/local-pipeline/local_ci-cd-pre"

if [[ ! -x "$pipeline" ]]; then
    echo "$(logger "pre") Pipeline is missing or not executable: $pipeline" >&2
    exit 1
fi

playbooks=false
for file in "$playbook_dir"/*.yml "$playbook_dir"/*.yml; do
    if [[ -f "$file" ]]; then
        playbooks=true
        break
    fi
done

if [[ "$playbooks" = true ]]; then
    echo "$(logger "pre") Triggering CI/CD"
    echo "$(logger "pre") Branch: $branch"
    echo "$(logger "pre") Commit: $commit"

    "$pipeline" "$repo_root" "$branch" "$commit"
fi
