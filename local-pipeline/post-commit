#!/usr/bin/env bash

set -u

logger() {
    local prefix=${1:-cicd}
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    printf '%s [%s-commit]:' "$ts" "$prefix"
}

repo_root=$(git rev-parse --show-toplevel) || exit 1
branch=$(git branch --show-current)
playbook_dir="$repo_root/playbooks"
tests_dir="$repo_root/tests"

commit=$(git rev-parse HEAD)

log_dir="$repo_root/logs" && mkdir -p "$log_dir"
git_log_file="$log_dir/git-hooks.log"
exec > >(tee -a >(sed $'s/\033\\[[0-9;]*m//g' >>"$git_log_file")) 2>&1

if [[ -z "$branch" ]]; then
    echo "$(logger "post") Detached HEAD; skipping CI/CD."
    exit 0
fi

if [[ "$branch" = "main" ]]; then
    echo "$(logger "post") Commit is on main; skipping CI/CD."
    exit 0
fi

pipeline="$repo_root/local-pipeline/local_ci-cd-post"

if [[ ! -x "$pipeline" ]]; then
    echo "$(logger "post") Pipeline is missing or not executable: $pipeline" >&2
    exit 1
fi

playbooks=false
for file in "$playbook_dir"/*.yml "$playbook_dir"/*.yml; do
    if [[ -f "$file" ]]; then
        playbooks=true
        break
    fi
done

if [[ "$playbooks" = true || -f "$tests_dir"/job.py ]]; then
    echo "$(logger "post") Triggering CI/CD"
    echo "$(logger "post") Branch: $branch"
    echo "$(logger "post") Commit: $commit"

    "$pipeline" "$repo_root" "$branch" "$commit"
fi
